#!/bin/sh
#
# rpcd backend for luci-app-hinet-multidial.
#   status              -> controller settings + live per-session state
#   dial   {iface?}     -> dial all (staggered) or one session
#   stop   {iface?}     -> hang up all or one session
#   redial {iface?}     -> stop+dial all or one session
#   apply               -> reconcile interfaces from config, reload
#   import              -> seed config 'session' sections from existing wanp*
#
. /usr/share/libubox/jshn.sh
. /usr/share/hinet-multidial/lib.sh

INIT=/etc/init.d/hinet-multidial

# Extract "up|l3dev|address|uptime" for one interface, in a subshell so its jshn
# parse of the ubus reply cannot clobber a JSON buffer the caller is building.
iface_info() (
	local ifc="$1" st up l3 uptime addr=""
	st=$(ubus call network.interface."$ifc" status 2>/dev/null) || st=""
	[ -n "$st" ] || { printf '0|||0\n'; return 0; }
	json_load "$st"
	json_get_var up up
	json_get_var l3 l3_device
	json_get_var uptime uptime
	if json_is_a ipv4_address array; then
		json_select ipv4_address
		if json_is_a 1 object; then
			json_select 1
			json_get_var addr address
			json_select ..
		fi
		json_select ..
	fi
	printf '%s|%s|%s|%s\n' "${up:-0}" "${l3:-}" "${addr:-}" "${uptime:-0}"
)

method_status() {
	local enabled boot_delay dial_delay user count ifc info up l3 addr uptime

	config_load hinet_multidial
	config_get_bool enabled main enabled 0
	config_get boot_delay main boot_delay 5
	config_get dial_delay main dial_delay 3
	config_get user main username ""
	count="$(hmd_count)"

	json_init
	json_add_boolean enabled "$enabled"
	json_add_int boot_delay "$boot_delay"
	json_add_int dial_delay "$dial_delay"
	json_add_int count "$count"
	json_add_string username "$user"
	json_add_array sessions
	for ifc in $(hmd_managed_ifaces); do
		info=$(iface_info "$ifc")
		up=${info%%|*};   info=${info#*|}
		l3=${info%%|*};   info=${info#*|}
		addr=${info%%|*}; uptime=${info#*|}
		json_add_object ""
		json_add_string  iface   "$ifc"
		json_add_int     index   "${ifc#wanp}"
		json_add_boolean up      "${up:-0}"
		json_add_string  device  "$l3"
		json_add_string  address "$addr"
		json_add_int     uptime  "${uptime:-0}"
		json_close_object
	done
	json_close_array
	json_dump
}

# Adopt any pre-existing wanp<i> interfaces: tag them managed_by=hinet-multidial,
# lift the shared account from the first one, and set 'count' to the highest
# contiguous index found. Used once to migrate a hand-built setup into the app.
method_import() {
	local ifc idx user pass first=1 maxidx=0 list=""
	# Scan for wanp1..6 pppoe sections directly (tagged or not — we are adopting
	# them). Must NOT use hmd_managed_ifaces here, which only returns tagged ones.
	config_load network
	_imp_collect() {
		case "$1" in wanp[1-6]) ;; *) return 0 ;; esac
		local p; config_get p "$1" proto ""
		[ "$p" = "pppoe" ] && list="$list $1"
	}
	config_foreach _imp_collect interface
	for ifc in $list; do
		idx="${ifc#wanp}"
		[ "$idx" -gt "$maxidx" ] && maxidx="$idx"
		user=$(uci -q get network."$ifc".username)
		pass=$(uci -q get network."$ifc".password)
		uci -q set network."$ifc".managed_by="$HMD_TAG"
		if [ "$first" = 1 ]; then
			uci -q set hinet_multidial.main.username="$user"
			uci -q set hinet_multidial.main.password="$pass"
			first=0
		fi
	done
	[ "$maxidx" -ge 1 ] && uci -q set hinet_multidial.main.count="$maxidx"
	uci -q commit network
	uci -q commit hinet_multidial
	json_init; json_add_boolean ok 1; json_add_int count "$maxidx"; json_dump
}

# Read optional {"iface":"wanpN"} from stdin.
_read_iface() {
	local input ifc=""
	input=$(cat)
	[ -n "$input" ] && { json_load "$input" 2>/dev/null && json_get_var ifc iface 2>/dev/null; }
	echo "$ifc"
}

method_dial() {
	local ifc; ifc=$(_read_iface)
	if [ -n "$ifc" ]; then $INIT dial_one "$ifc" >/dev/null 2>&1
	else $INIT dial_all >/dev/null 2>&1; fi
	json_init; json_add_boolean ok 1; json_dump
}

method_stop() {
	local ifc; ifc=$(_read_iface)
	if [ -n "$ifc" ]; then $INIT stop_one "$ifc" >/dev/null 2>&1
	else $INIT stop_all >/dev/null 2>&1; fi
	json_init; json_add_boolean ok 1; json_dump
}

method_redial() {
	local ifc; ifc=$(_read_iface)
	if [ -n "$ifc" ]; then
		hmd_is_managed "$ifc" && { ifdown "$ifc" >/dev/null 2>&1; sleep 1; ifup "$ifc" >/dev/null 2>&1; }
	else $INIT stop_all >/dev/null 2>&1; sleep 1; $INIT dial_all >/dev/null 2>&1; fi
	json_init; json_add_boolean ok 1; json_dump
}

method_apply() {
	local out; out=$(hmd_reconcile 2>&1)
	json_init
	case "$out" in
		ABORT:*) json_add_boolean ok 0 ;;
		*)       json_add_boolean ok 1 ;;
	esac
	json_add_string message "$out"
	json_dump
}

# Read {"index":N} from stdin.
_read_index() {
	local input idx=""
	input=$(cat)
	[ -n "$input" ] && { json_load "$input" 2>/dev/null && json_get_var idx index 2>/dev/null; }
	echo "$idx"
}

# Live WireGuard tunnel state for the active sessions (1..count).
method_wg_status() {
	local wg_en ip i port up hs rx tx active

	config_load hinet_multidial
	config_get_bool wg_en main wg_enabled 0
	ip="$(hmd_wan_ip)"
	active="$(hmd_desired | awk -F'\t' '{print $1}')"

	json_init
	json_add_boolean enabled "$wg_en"
	json_add_string endpoint "$ip"
	json_add_array tunnels
	for i in $active; do
		[ -n "$i" ] || continue
		port="$(hmd_wg_port "$i")"
		up=0; hs=0; rx=0; tx=0
		if [ -d /sys/class/net/wg$i ]; then
			up=1
			hs=$(wg show wg$i latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')
			set -- $(wg show wg$i transfer 2>/dev/null | awk 'NR==1{print $2, $3}')
			rx=${1:-0}; tx=${2:-0}
		fi
		json_add_object ""
		json_add_int     index     "$i"
		json_add_string  session   "wanp$i"
		json_add_int     port      "$port"
		json_add_string  pubkey    "$(uci -q get hinet_multidial.wg$i.public_key)"
		json_add_boolean up        "$up"
		json_add_int     handshake "${hs:-0}"
		json_add_int     rx        "${rx:-0}"
		json_add_int     tx        "${tx:-0}"
		json_close_object
	done
	json_close_array
	json_dump
}

# Return the downloadable client .conf (+ QR SVG if qrencode is present).
method_wg_config() {
	local idx conf qr
	idx=$(_read_index)
	json_init
	case "$idx" in ''|*[!0-9]*) json_add_boolean ok 0; json_add_string error "bad index"; json_dump; return ;; esac
	conf="$(hmd_wg_client_conf "$idx" 2>/dev/null)"
	if [ -z "$conf" ]; then
		json_add_boolean ok 0
		json_add_string error "no keys yet — enable WireGuard and Save & Apply first"
		json_dump; return
	fi
	json_add_boolean ok 1
	json_add_string conf "$conf"
	if command -v qrencode >/dev/null 2>&1; then
		qr="$(printf '%s' "$conf" | qrencode -t SVG -o - 2>/dev/null)"
		[ -n "$qr" ] && json_add_string qr "$qr"
	fi
	json_dump
}

# Set (or regenerate) the pre-shared key for tunnel <index>, then reconcile.
method_wg_set_psk() {
	local input idx psk=""
	input=$(cat)
	json_load "$input" 2>/dev/null
	json_get_var idx index 2>/dev/null
	json_get_var psk psk 2>/dev/null
	json_init
	case "$idx" in ''|*[!0-9]*) json_add_boolean ok 0; json_dump; return ;; esac
	hmd_wg_ensure_keys
	[ -n "$psk" ] || psk="$(wg genpsk)"
	uci -q set hinet_multidial.wg$idx.psk="$psk"
	uci -q commit hinet_multidial
	hmd_reconcile >/dev/null 2>&1
	json_add_boolean ok 1; json_add_string psk "$psk"; json_dump
}

# Rotate the keypair(s) — invalidates existing client configs. Then reconcile.
method_wg_genkeys() {
	local idx i priv pub cpriv cpub
	idx=$(_read_index)
	_regen() {
		local i="$1"
		priv="$(wg genkey)";  pub="$(printf '%s' "$priv"  | wg pubkey)"
		cpriv="$(wg genkey)"; cpub="$(printf '%s' "$cpriv" | wg pubkey)"
		uci -q set hinet_multidial.wg$i='wg'
		uci -q set hinet_multidial.wg$i.private_key="$priv"
		uci -q set hinet_multidial.wg$i.public_key="$pub"
		uci -q set hinet_multidial.wg$i.client_key="$cpriv"
		uci -q set hinet_multidial.wg$i.client_pub="$cpub"
		[ -n "$(uci -q get hinet_multidial.wg$i.psk)" ] || uci -q set hinet_multidial.wg$i.psk="$(wg genpsk)"
	}
	if printf '%s' "$idx" | grep -qE '^[0-9]+$'; then
		_regen "$idx"
	else
		i=1; while [ "$i" -le "$HMD_MAX" ]; do _regen "$i"; i=$((i + 1)); done
	fi
	uci -q commit hinet_multidial
	hmd_reconcile >/dev/null 2>&1
	json_init; json_add_boolean ok 1; json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "status"; json_close_object
		json_add_object "dial";   json_add_string "iface" ""; json_close_object
		json_add_object "stop";   json_add_string "iface" ""; json_close_object
		json_add_object "redial"; json_add_string "iface" ""; json_close_object
		json_add_object "apply";  json_close_object
		json_add_object "import"; json_close_object
		json_add_object "wg_status"; json_close_object
		json_add_object "wg_config";  json_add_int    "index" 0; json_close_object
		json_add_object "wg_set_psk"; json_add_int    "index" 0; json_add_string "psk" ""; json_close_object
		json_add_object "wg_genkeys"; json_add_int    "index" 0; json_close_object
		json_dump
		;;
	call)
		case "$2" in
			status)     method_status ;;
			dial)       method_dial ;;
			stop)       method_stop ;;
			redial)     method_redial ;;
			apply)      method_apply ;;
			import)     method_import ;;
			wg_status)  method_wg_status ;;
			wg_config)  method_wg_config ;;
			wg_set_psk) method_wg_set_psk ;;
			wg_genkeys) method_wg_genkeys ;;
			*)          echo '{}' ;;
		esac
		;;
esac
