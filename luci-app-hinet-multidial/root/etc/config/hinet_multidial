
config controller 'main'
	# Master switch: dial the sessions automatically at boot.
	# 0 = leave sessions down at boot (dial manually from LuCI).
	option enabled '0'
	# Seconds to wait after boot before the first session is dialed.
	option boot_delay '5'
	# Seconds to wait between each session's dial (avoids a simultaneous
	# burst of PPPoE PADI discovery frames).
	option dial_delay '3'
	# Number of PPPoE sessions / public IPs to dial: 1..6.
	# Maps to interfaces wanp1..wanp<count>, each on private table 100+index.
	option count '1'
	# PPPoE account shared by every session (HiNet allows this).
	option username ''
	option password ''
	# WireGuard egress tunnels: one per active session (wg<i> -> wanp<i>).
	# Clients connect to wan0's IP on port (wg_port_base + index); their
	# internet traffic exits via that session's public IP. 0 = disabled.
	option wg_enabled '0'
	option wg_port_base '51820'

# One 'wg' section per slot holds the fixed keypairs + PSK (auto-generated
# on first apply, then stable). The PSK is user-editable from the LuCI panel.
