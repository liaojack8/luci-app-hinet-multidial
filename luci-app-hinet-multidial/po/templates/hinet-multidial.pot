msgstr ""

msgid "Auto-dial at boot"
msgstr ""

msgid "When on, the sessions are dialed automatically at boot. When off they stay down until dialed here."
msgstr ""

msgid "Initial delay (seconds)"
msgstr ""

msgid "Wait this long after boot before the first dial, letting the DHCP WAN settle."
msgstr ""

msgid "Delay between sessions (seconds)"
msgstr ""

msgid "Gap between each dial — staggering avoids a burst of simultaneous PPPoE discovery frames."
msgstr ""

msgid "Live Sessions"
